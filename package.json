{
  "name": "clifjordan",
  "version": "1.0.0",
  "description": "My personal playground",
  "private": true,
  "main": "app.js",
  "scripts": {
    "start": "node ./bin/www",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:reload\"",
    "dev:server": "NODE_ENV=development nodemon --watch app.js --watch bin/www --watch routes --watch views --ext js,nunjucks ./bin/www",
    "dev:reload": "livereload public views --port 35729 --wait 200"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamclif/clifjordan.git"
  },
  "author": "Clifford <clifford.jordan@etrade.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/iamclif/clifjordan/issues"
  },
  "homepage": "https://github.com/iamclif/clifjordan#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.1.0",
    "morgan": "^1.10.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "livereload": "^0.10.3",
    "nodemon": "^3.1.10"
  }
}
