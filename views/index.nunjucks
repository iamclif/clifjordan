{% extends 'layout.nunjucks' %}

{% block content %}
<main class="home">
  <header class="masthead" data-reveal>
    <div class="masthead__brand">
      <img class="logo" src="/images/clif-jordan-logo.png" alt="Clif Jordan logo">
      <p class="brand-copy">{{ site.role }}</p>
    </div>

    <nav aria-label="Contact links">
      <div class="hero__actions">
        <a class="button button--primary" href="https://www.linkedin.com/in/clifjordanq" target="_blank" rel="noreferrer">Connect on LinkedIn</a>
      </div>
    </nav>
  </header>

  <section class="hero" data-reveal>
    <div class="hero__copy">
      <h1>Front End Developer. </br> Trail Rambler, Space Geek and Lover of Cocktails.</h1>
      <div class="hero__lede">
        <p>Hey there, I'm Clif, a Adirondack based developer.</p>
        <p>I specialize in design systems.</p>
        <p>Technically skilled and forward-thinking. I am curious, passionate, and a collaborative problem solver. I enjoy doing my bit to make the web a great place to work and play in.</p>
        <p>My many years of creative agency experience has made me an expert at bridging the gap between design objectives and technical implementation.</p>
        <p>I am cool under pressure and a strong team member.</p>
      </div>
    </div>

    <aside class="hero__panel" aria-label="Core strengths">
      <p class="panel-label">About Me</p>
      <ul class="feature-list">
        <li><a class="button button--primary" href="/photos">Photos</a></li>
        <li>Creative agency experience with strong delivery instincts</li>
        <li>Calm collaboration under pressure</li>
      </ul>
      <div class="hero__panel-actions">
        
      </div>
    </aside>
  </section>
</main>
{% endblock %}
